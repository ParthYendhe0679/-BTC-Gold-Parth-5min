# Copy to .env for local runs. On Render, set these in Dashboard → Environment.
# NEVER commit real values.

# ── Required ────────────────────────────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_api_key
BOT_TOKEN=123456789:your_telegram_bot_token
CHAT_ID=123456789

# ── Recommended security ────────────────────────────────────────────────────
# If set, POST /webhook must include "secret": "<value>" in the JSON body.
WEBHOOK_SECRET=
# If set, GET /scanner/test-alert requires ?token=<value>.
ADMIN_TOKEN=

# ── Optional tuning (defaults shown) ────────────────────────────────────────
# Comma-separated strategy ids. ENABLED_STRATEGIES (if set) is an allow-list.
# Ids: SUPERTREND_10_3, SUPERTREND_20_3, EMA5_CROSS, FIB_GOLDEN_ZONE,
#      POS_5EMA, RSI2_MEAN_REVERSION, LIQUIDITY_SWEEP
ENABLED_STRATEGIES=
DISABLED_STRATEGIES=
# JSON per-strategy parameter overrides, e.g. {"RSI2_MEAN_REVERSION": {"oversold": 5}}
STRATEGY_PARAMS=
TELEGRAM_COMMANDS_ENABLED=true
SCAN_DELAY_SECONDS=8
STALE_RETRY_SECONDS=20
MAX_SIGNAL_AGE_SECONDS=600
OUTPUT_SIZE=700
DAILY_CREDIT_BUDGET=780
STATE_DB_PATH=data/state.db
